# Entity: login

main: kit: entity: login: {

  alias: field: {}

  fields: {
    captcha: {
      h: "Captcha"
      n: "captcha"
      r: true
      sh: "Captcha code displayed in the image"
      t: "`$STRING`"
    }
    expiresIn: {
      h: "Expires In"
      n: "expiresIn"
      r: false
      sh: "Token expiration time in seconds"
      t: "`$INTEGER`"
    }
    password: {
      fo: "password"
      h: "Password"
      n: "password"
      r: true
      sh: "User's password"
      t: "`$STRING`"
    }
    success: {
      h: "Success"
      n: "success"
      r: false
      t: "`$BOOLEAN`"
    }
    token: {
      h: "Token"
      n: "token"
      r: false
      sh: "Authentication token"
      t: "`$STRING`"
    }
    user: {
      h: "User"
      n: "user"
      r: false
      t: "`$OBJECT`"
    }
    username: {
      h: "Username"
      n: "username"
      r: true
      sh: "User's username or NID number"
      t: "`$STRING`"
    }
  }

  name: "login"
  op: {
    create: {
      name: "create"
      points: [
        {
          bf: [
            "captcha"
            "password"
            "username"
          ]
          co: {
            id: "POST /auth/login"
            source: "openapi3"
            version: 2
          }
          m: "POST"
          o: "/auth/login"
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "auth"
            }
            {
              lit: "login"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
