      type: "`$STRING`"
    }
    {
      format: "date"
      name: "dateOfBirth"
      req: false
      short: "Date of birth"
      type: "`$STRING`"
    }
    {
      format: "email"
      name: "email"
      req: true
      short: "User's email address"
      type: "`$STRING`"
    }
    {
      name: "nidNumber"
      req: true
      short: "National Identity Card number"
      type: "`$STRING`"
    }
    {
      format: "password"
      name: "password"
      req: true
      short: "Account password"
      type: "`$STRING`"
    }
    {
      name: "phone"
      req: false
      short: "User's phone number"
